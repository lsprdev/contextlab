# Build a project-specific derived image to install its pinned dependencies.
# Generation never uses this image. Evaluation has no network access.
FROM python:3.12.11-slim
RUN python -m pip install --no-cache-dir pytest==8.4.2 coverage==7.10.7
WORKDIR /project
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
