{
  "schema_version": 1,
  "phase": "demo",
  "seed": 42,
  "conditions": ["L", "R", "A"],
  "repetitions": 1,
  "limits": {
    "context_chars": 30000,
    "tool_calls": 20,
    "generation_seconds": 120,
    "evaluation_seconds": 20
  },
  "agents": [
    {"id": "fixture", "kind": "fixture", "fixture_dir": "fixtures"}
  ],
  "evaluation": {
    "backend": "local",
    "image": "contextlab-evaluator:local"
  },
  "projects": [
    {
      "id": "loja",
      "root": "loja",
      "source_roots": ["."],
      "include": ["loja/*.py", "docs/regras.md"],
      "evaluation_include": ["loja/*.py", "reference/*.py"],
      "targets": [
        {
          "id": "frete",
          "path": "loja/frete.py",
          "symbol": "calcular_frete",
          "import": "loja.frete:calcular_frete",
          "reference_tests": ["reference/test_frete.py"],
          "defects": [
            {
              "id": "vip-limite",
              "path": "loja/frete.py",
              "old": "peso <= 5",
              "new": "peso < 5",
              "witness": "reference/test_frete.py::test_limite_vip"
            }
          ]
        }
      ]
    },
    {
      "id": "agenda",
      "root": "agenda",
      "source_roots": ["."],
      "include": ["agenda/*.py", "docs/regras.md"],
      "evaluation_include": ["agenda/*.py", "reference/*.py"],
      "targets": [
        {
          "id": "preco",
          "path": "agenda/preco.py",
          "symbol": "calcular_preco",
          "import": "agenda.preco:calcular_preco",
          "reference_tests": ["reference/test_preco.py"],
          "defects": [
            {
              "id": "desconto-limite",
              "path": "agenda/preco.py",
              "old": "reserva.minutos >= 120",
              "new": "reserva.minutos > 120",
              "witness": "reference/test_preco.py::test_limite_desconto"
            }
          ]
        }
      ]
    }
  ]
}
